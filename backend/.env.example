# --- Base de données ---
# Option A (recommandé en prod / Supabase) : une seule URL
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxxx.supabase.co:5432/postgres
# SSL activé automatiquement si DATABASE_URL est défini (sauf DB_SSL=false)
# DB_SSL=false

# Option B (local) : variables séparées
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=notes_moyennes

# true = TypeORM crée/maj les tables (pratique au 1er déploiement beta)
# Remettre false ou supprimer une fois les tables créées
DB_SYNCHRONIZE=true

# Authentification
JWT_SECRET=change_this_secret_in_production_min_32_chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Frontend (CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Serveur
PORT=4000
NODE_ENV=development

# Mode beta : true = classes & PDF illimités, paiements désactivés
BETA_GRATUIT=true

# CinetPay (optionnel en beta)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=

# Email (Resend) — réinitialisation de mot de passe
# Créer un compte sur https://resend.com puis récupérer l'API key
RESEND_API_KEY=
# Expéditeur vérifié (ex. MoyennePro <noreply@ton-domaine.com>)
# En test gratuit Resend autorise : onboarding@resend.dev
EMAIL_FROM=MoyennePro <onboarding@resend.dev>
